{
    "name": "trustportidentity/beacon-laravel",
    "description": "Official TrustPort Beacon APM and Telemetry SDK for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "apm",
        "observability",
        "tracing",
        "beacon",
        "laravel"
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "TrustPortIdentity\\Beacon\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TrustPortIdentity\\Beacon\\BeaconServiceProvider"
            ],
            "aliases": {
                "Beacon": "TrustPortIdentity\\Beacon\\Beacon"
            }
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrustPortIdentity\\Beacon\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
